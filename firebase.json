{
  "hosting": {
    "public": "build",
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/en",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/en/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/en/:path*",
        "destination": "/:path/",
        "type": 301
      },
      {
        "source": "/translate_flower",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/translate_flower/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/translate_app",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/translate_app/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/:lang/translate_flower",
        "destination": "/:lang/",
        "type": 301
      },
      {
        "source": "/:lang/translate_flower/",
        "destination": "/:lang/",
        "type": 301
      },
      {
        "source": "/:lang/translate_app",
        "destination": "/:lang/",
        "type": 301
      },
      {
        "source": "/:lang/translate_app/",
        "destination": "/:lang/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
